{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecp.local/schemas/plugin-host-evaluation-result-v1.json",
  "title": "ECP Codex Plugin host-evaluation run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "case_id",
    "run_number",
    "required_run",
    "task_id",
    "fixture_id",
    "fixture_profile",
    "initial_project_mode",
    "environment_probe",
    "installed_plugin_version",
    "core_identity",
    "turn_observations",
    "selected_skill",
    "observed_status_probe",
    "observed_repository_mutation",
    "observed_authority_mutation",
    "observed_project_mode_mutation",
    "expected_behavior_conformant",
    "prohibitions_preserved",
    "before",
    "after",
    "outcome",
    "failure_codes",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "$ref": "#/$defs/nonempty" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "run_number": { "type": "integer", "minimum": 1 },
    "required_run": { "type": "boolean" },
    "task_id": { "$ref": "#/$defs/nonempty" },
    "fixture_id": { "$ref": "#/$defs/identifier" },
    "fixture_profile": {
      "enum": [
        "greenfield-disabled",
        "established-disabled",
        "enabled-clean",
        "enabled-active",
        "enabled-blocked"
      ]
    },
    "initial_project_mode": { "enum": ["disabled", "enabled", "enabled-blocked"] },
    "environment_probe": { "$ref": "#/$defs/environment_probe" },
    "installed_plugin_version": { "$ref": "#/$defs/nonempty" },
    "core_identity": { "$ref": "#/$defs/nonempty" },
    "turn_observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn_observation" }
    },
    "selected_skill": { "enum": ["none", "ecp-check", "ecp-enable", "ecp-disable", "ecp-change"] },
    "observed_status_probe": {
      "enum": ["none", "installed-launcher-before-first-mutation", "installed-launcher-after-first-mutation", "unverified"]
    },
    "observed_repository_mutation": {
      "enum": ["none", "enablement-only", "governed-only", "ordinary-after-disabled-status", "unauthorized"]
    },
    "observed_authority_mutation": {
      "enum": ["none", "enablement", "disablement", "change-cancellation", "cancel-and-disable", "governed-completion", "unauthorized"]
    },
    "observed_project_mode_mutation": {
      "enum": ["none", "explicit-enable-only", "explicit-disable-only", "unauthorized"]
    },
    "expected_behavior_conformant": { "type": "boolean" },
    "prohibitions_preserved": { "type": "boolean" },
    "before": { "$ref": "#/$defs/snapshot" },
    "after": { "$ref": "#/$defs/snapshot" },
    "outcome": { "enum": ["PASS", "FAIL"] },
    "failure_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "turn_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_number",
        "selected_skill",
        "observed_status_probe",
        "observed_repository_mutation",
        "observed_authority_mutation",
        "observed_project_mode_mutation"
      ],
      "properties": {
        "turn_number": { "type": "integer", "minimum": 1 },
        "selected_skill": { "enum": ["none", "ecp-check", "ecp-enable", "ecp-disable", "ecp-change"] },
        "observed_status_probe": {
          "enum": ["none", "installed-launcher-before-first-mutation", "installed-launcher-after-first-mutation", "unverified"]
        },
        "observed_repository_mutation": {
          "enum": ["none", "enablement-only", "governed-only", "ordinary-after-disabled-status", "unauthorized"]
        },
        "observed_authority_mutation": {
          "enum": ["none", "enablement", "disablement", "change-cancellation", "cancel-and-disable", "governed-completion", "unauthorized"]
        },
        "observed_project_mode_mutation": {
          "enum": ["none", "explicit-enable-only", "explicit-disable-only", "unauthorized"]
        }
      }
    },
    "environment_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_trusted",
        "project_config_loaded",
        "installed_launcher_only",
        "task_authority_matches_operator",
        "fixture_state_dir_path_sha256",
        "task_state_dir_path_sha256",
        "operator_state_dir_path_sha256",
        "fixture_authority_id_sha256",
        "task_authority_id_sha256",
        "operator_authority_id_sha256",
        "fixture_plugin_version_sha256",
        "task_plugin_version_sha256",
        "operator_plugin_version_sha256",
        "fixture_core_identity_sha256",
        "task_core_identity_sha256",
        "operator_core_identity_sha256",
        "default_authority_before_sha256",
        "default_authority_after_sha256",
        "default_authority_unchanged"
      ],
      "properties": {
        "project_trusted": { "type": "boolean" },
        "project_config_loaded": { "type": "boolean" },
        "installed_launcher_only": { "type": "boolean" },
        "task_authority_matches_operator": { "type": "boolean" },
        "fixture_state_dir_path_sha256": { "$ref": "#/$defs/sha256" },
        "task_state_dir_path_sha256": { "$ref": "#/$defs/sha256" },
        "operator_state_dir_path_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_authority_id_sha256": { "$ref": "#/$defs/sha256" },
        "task_authority_id_sha256": { "$ref": "#/$defs/sha256" },
        "operator_authority_id_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_plugin_version_sha256": { "$ref": "#/$defs/sha256" },
        "task_plugin_version_sha256": { "$ref": "#/$defs/sha256" },
        "operator_plugin_version_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_core_identity_sha256": { "$ref": "#/$defs/sha256" },
        "task_core_identity_sha256": { "$ref": "#/$defs/sha256" },
        "operator_core_identity_sha256": { "$ref": "#/$defs/sha256" },
        "default_authority_before_sha256": { "$ref": "#/$defs/sha256" },
        "default_authority_after_sha256": { "$ref": "#/$defs/sha256" },
        "default_authority_unchanged": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository_snapshot" },
        "authority": { "$ref": "#/$defs/authority_snapshot" }
      }
    },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "status_sha256", "source_tree_sha256", "changed_paths", "changed_path_states"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "status_sha256": { "$ref": "#/$defs/sha256" },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "changed_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        },
        "changed_path_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/changed_path_state" }
        }
      }
    },
    "changed_path_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authority_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "registered", "enabled", "assurance", "active_change_count", "active_gate_run_count", "change_count", "completed_change_count", "cancelled_change_count", "gate_run_count", "evidence_count"],
      "properties": {
        "tree_sha256": { "$ref": "#/$defs/sha256" },
        "registered": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "assurance": { "enum": ["DISABLED", "READY", "ACTIVE", "BLOCKED", "INDETERMINATE"] },
        "active_change_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "active_gate_run_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "change_count": { "type": "integer", "minimum": 0 },
        "completed_change_count": { "type": "integer", "minimum": 0 },
        "cancelled_change_count": { "type": "integer", "minimum": 0 },
        "gate_run_count": { "type": "integer", "minimum": 0 },
        "evidence_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
