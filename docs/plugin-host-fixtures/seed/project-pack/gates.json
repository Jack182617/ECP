{
  "schema_version": 1,
  "gates": [
    {
      "id": "unit-tests",
      "description": "Run the disposable fixture unit tests",
      "tier": "fast",
      "command": [
        "/usr/bin/python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "working_directory": ".",
      "timeout_seconds": 30,
      "allowed_exit_codes": [
        0
      ],
      "required_for": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "inherit_environment": [],
      "max_output_bytes": 65536,
      "requires_network": false,
      "produces_external_side_effects": false
    }
  ]
}
